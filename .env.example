# Configuration for `docker compose`. Copy to `.env` — gitignored — and fill in the two
# required values; Compose refuses to start rather than default to something insecure.

# Required. Generate the key: python -c "import secrets; print(secrets.token_urlsafe(48))"
POSTGRES_PASSWORD=
SECRET_KEY=

# Optional — these are the defaults Compose uses if absent.
POSTGRES_DB=innovation_platform
POSTGRES_USER=postgres
WEB_PORT=8080
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:8080
LOG_LEVEL=INFO
LOG_JSON=true
# Proxies in front of the API. 1 is the `web` container. Raise it if you add a CDN or
# tunnel; never 0, or a caller can pick their own rate-limit bucket via a header.
TRUSTED_PROXY_HOPS=1

# Optional — EPO Open Patent Services, free tier from developers.epo.org. The platform
# runs without them: the patent modules read the seeded cache in backend/app/data.
OPS_CONSUMER_KEY=
OPS_CONSUMER_SECRET=
