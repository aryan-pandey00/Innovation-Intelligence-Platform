# Copy to backend/.env and fill in. `.env` is gitignored.
# Not needed for `docker compose` — that reads the repository-root .env instead.

# `postgres://` and `postgresql://` are both rewritten to the installed driver
# (psycopg 3), so a URL copied from a managed provider works as given.
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/innovation_platform

# Signs every session token: whoever knows it can forge one for any account. Fine
# locally; in production generate one — python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-this-secret-key-please
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# `development` or `production`. Production refuses the key above, or any under 32 chars.
ENVIRONMENT=development

# Comma-separated origins allowed to call the API directly. Behind the production nginx
# the browser uses the same origin as the page, so this is not on the critical path.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# LOG_JSON=true emits one JSON object per line for a collector; false is readable.
LOG_LEVEL=INFO
LOG_JSON=false

# Proxies in front of this process. 0 is right only when nothing forwards to it —
# behind nginx or Render, 0 lets a caller pick their own rate-limit bucket via a header.
TRUSTED_PROXY_HOPS=0

# EPO Open Patent Services, free tier from developers.epo.org. Blank is fine: the
# patent modules read the seeded cache and only need these to add a new technology.
OPS_CONSUMER_KEY=
OPS_CONSUMER_SECRET=
