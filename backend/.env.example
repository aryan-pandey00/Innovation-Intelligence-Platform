# Copy this to .env and fill in your values
DATABASE_URL=postgresql://postgres:password@localhost:5432/innovation_platform
SECRET_KEY=change-this-to-a-random-secret-key-in-production-please-make-it-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# EPO Open Patent Services — free tier, register at developers.epo.org.
# Leave blank to run without them: the patent modules read the cached data in
# app/data and only need these to seed a technology that is not cached yet.
OPS_CONSUMER_KEY=
OPS_CONSUMER_SECRET=
