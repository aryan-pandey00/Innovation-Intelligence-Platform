{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://innovation-intelligence-platform.onrender.com/api/:path*"
    },
    {
      "source": "/docs",
      "destination": "https://innovation-intelligence-platform.onrender.com/docs"
    },
    {
      "source": "/redoc",
      "destination": "https://innovation-intelligence-platform.onrender.com/redoc"
    },
    {
      "source": "/openapi.json",
      "destination": "https://innovation-intelligence-platform.onrender.com/openapi.json"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
